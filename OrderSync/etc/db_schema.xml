<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="goodahead_ordersync_dispatch" resource="default" engine="innodb"
           comment="One row per logical delivery of an order event to the finance system">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order entity ID"/>
        <column xsi:type="varchar" name="increment_id" nullable="false" length="32" comment="Order increment ID"/>
        <column xsi:type="varchar" name="event_type" nullable="false" length="32" comment="order_placed or order_cancelled"/>
        <column xsi:type="varchar" name="idempotency_key" nullable="false" length="128" comment="Stable key derived from the order, sent to the endpoint"/>
        <column xsi:type="varchar" name="status" nullable="false" length="16" default="pending" comment="pending, in_progress, succeeded or failed"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0" comment="Delivery attempts so far"/>
        <column xsi:type="timestamp" name="next_attempt_at" nullable="true" comment="Earliest time the next attempt may run"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Last failure, for an operator"/>
        <column xsi:type="smallint" name="last_status_code" unsigned="true" nullable="true" comment="Last HTTP status received"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated at"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <constraint xsi:type="unique" referenceId="GOODAHEAD_ORDERSYNC_DISPATCH_ORDER_ID_EVENT_TYPE">
            <column name="order_id"/>
            <column name="event_type"/>
        </constraint>

        <constraint xsi:type="foreign" referenceId="GOODAHEAD_ORDERSYNC_DISPATCH_ORDER_ID_SALES_ORDER_ENTITY_ID"
                    table="goodahead_ordersync_dispatch" column="order_id"
                    referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>

        <index referenceId="GOODAHEAD_ORDERSYNC_DISPATCH_STATUS_NEXT_ATTEMPT_AT" indexType="btree">
            <column name="status"/>
            <column name="next_attempt_at"/>
        </index>
    </table>
</schema>
