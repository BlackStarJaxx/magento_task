# Magento application root is not ours to ship — only our modules are tracked.
# Stepwise un-ignore: git cannot un-ignore a path inside an ignored directory.
/src/*
!/src/app/
/src/app/*
!/src/app/code/
/src/app/code/*
!/src/app/code/Goodahead/

# Generated by bin/detect-versions
compose.versions.yaml

# Working notes — not deliverables. ADRs and verification evidence ARE shipped
# (docs/adr/, docs/verification/); these two are the draft reasoning behind them.
/docs/ANALYSIS.md
/docs/PLAN.md

# The task brief itself is their document, not our solution
Goodahead-Backend-Task.pdf

# IDE
.idea/
.vscode/

# Local overrides
compose.dev-*.local.yaml
*.local
