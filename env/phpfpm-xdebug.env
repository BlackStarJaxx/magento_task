PHP_IDE_CONFIG="serverName=magento"
XDEBUG_MODE=develop,debug
## Sets xdebug.idekey (Xdebug falls back to this env var when the ini is
## empty). Required for PhpStorm "PHP Remote Debug" run configs, which
## filter incoming connections by IDE key. Must match the run config's
## "IDE key (session id)" field.
DBGP_IDEKEY=PHPSTORM
