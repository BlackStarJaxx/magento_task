<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Goodahead\PaymentTiers\Api\Data\CheckoutTierInterface"
                type="Goodahead\PaymentTiers\Model\Checkout\CheckoutTier"/>

    <type name="StripeIntegration\Payments\Helper\PaymentIntent">
        <plugin name="goodahead_payment_tiers_guard_confirmation"
                type="Goodahead\PaymentTiers\Plugin\GuardPaymentIntentConfirmation"
                sortOrder="10"/>
    </type>

    <type name="StripeIntegration\Payments\Model\PaymentIntent">
        <plugin name="goodahead_payment_tiers_stamp_intent"
                type="Goodahead\PaymentTiers\Plugin\StampIntentForTier"
                sortOrder="10"/>
    </type>

    <type name="StripeIntegration\Payments\Model\PaymentElement">
        <plugin name="goodahead_payment_tiers_verify_after_confirmation"
                type="Goodahead\PaymentTiers\Plugin\VerifyBrandAfterConfirmation"
                sortOrder="10"/>
    </type>

    <type name="StripeIntegration\Payments\Model\ExpressCheckout\Config">
        <plugin name="goodahead_payment_tiers_hide_express"
                type="Goodahead\PaymentTiers\Plugin\Checkout\HideExpressCheckoutWithoutCards"
                sortOrder="10"/>
    </type>

    <type name="Magento\Quote\Api\CartTotalRepositoryInterface">
        <plugin name="goodahead_payment_tiers_totals"
                type="Goodahead\PaymentTiers\Plugin\Checkout\AddTierToTotals"
                sortOrder="10"/>
    </type>
</config>
